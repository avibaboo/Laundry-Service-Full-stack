# Copy this file to .env and fill in your values
# cp .env.example .env

PORT=5000

# PostgreSQL connection string (get from Neon: https://neon.tech)
# Format: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# Generate a strong random secret: openssl rand -base64 64
JWT_SECRET=your_strong_random_jwt_secret_here

# Gmail address used to send emails
EMAIL_USER=your_gmail@gmail.com

# Gmail App Password (16 chars, NOT your Gmail password)
# Get it at: https://myaccount.google.com/apppasswords
EMAIL_PASS=your_16_char_app_password

# URL of your frontend (used in password reset emails)
FRONTEND_URL=http://localhost:5173
